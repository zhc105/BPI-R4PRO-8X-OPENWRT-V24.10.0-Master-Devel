# Build output — these are regenerated by `make` and are ~50 GB in total.
/build_dir/
/staging_dir/
/bin/
/tmp/
/logs/
/.ccache/
/env/

# Image signing keys — key-build is a PRIVATE key generated by the build.
# Committing it would let anyone sign packages that this firmware trusts.
/key-build
/key-build.*

# Local build configuration. `.config` and `.config.old` are tracked in this
# fork (BPI committed them); the manual backups are not.
/.config.bak*
/tmp.config

# Shell / tool history that ends up in the tree because the repo root is used
# as a working directory.
/.bash_history
/.python_history
/.ash_history
/.viminfo

# Field notes for the running hardware. They contain the WAN address, the SSH
# port, LAN addressing, MAC addresses and firewall details, so they must not be
# published from a public fork. Keep them locally (or in a private repo).
/RUNTIME-CHANGES.md
/WIFI-DEBUG-NOTES.md

# Packet captures — real traffic, including the public IP and session metadata.
*.pcap
*.pcapng

# Host-tool objects that appear inside the vendored feeds when luci's
# po2lmo/jsmin get built. (`contrib/lemon` is tracked upstream, so it is not
# listed here; the .o files under dl/go-mod-cache are upstream content and stay
# tracked — these rules match by path, not by extension.)
/feeds/luci/modules/luci-base/src/*.o
/feeds/luci/modules/luci-base/src/lib/*.o
/feeds/luci/modules/luci-base/src/po2lmo
/feeds/luci/modules/luci-base/src/jsmin

# Kconfig host tools built in-tree by `make menuconfig` / `make defconfig`.
# (lexer.lex.c / parser.tab.[ch] are generated too but tracked upstream.)
/scripts/config/conf
/scripts/config/mconf
/scripts/config/*.o

# wget's HSTS database records which https hosts this tree contacted.
/.wget-hsts
